HOST=127.0.0.1
PORT=3001
# Desarrollo: PostgreSQL embebido y persistente en ./data/db.
# Producción: PostgreSQL del datacenter; no usar el modo embebido.
# DATABASE_URL=postgres://rastreo:CLAVE@localhost:5432/rastreo
DATA_DIR=./data
UPLOAD_DIR=./uploads
APP_ORIGIN=http://localhost:5173
# NODE_ENV=production exige HTTPS, DATABASE_URL y cookies seguras.
# Creación inicial: configurar temporalmente y ejecutar npm run bootstrap.
# BOOTSTRAP_USER=admin
# BOOTSTRAP_PASSWORD=una-clave-unica-de-al-menos-12-caracteres
# Importación inicial opcional, sólo durante bootstrap:
# CAMERA_KML=C:/ruta/camaras.kml

# Sincronización automática. El mapa debe permitir descargar el KML sin iniciar sesión.
MY_MAPS_ID=
MY_MAPS_INTERVAL_SECONDS=300
# Dirección HTTPS del servicio OpenAPI, por ejemplo https://hik.example.org:443
# No usar /#/portal. Guardar las claves sólo en .env local, nunca en Git.
HIK_OPENAPI_URL=
HIK_APP_KEY=
HIK_APP_SECRET=
HIK_INTERVAL_SECONDS=60
# Grabaciones históricas: 0=principal (predeterminado), 1=auxiliar.
HIK_RECORD_TYPE=0
# Opcional: correspondencias explícitas número del mapa -> cameraIndexCode.
# Si se omite, vincula por prefijo CAM-número sólo cuando es único.
# HIK_CAMERA_MAPPING='{"276":"identificador-hikcentral"}'
# Para una CA privada, iniciar Node con NODE_EXTRA_CA_CERTS=C:/ruta/ca.pem
